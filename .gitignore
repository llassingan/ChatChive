# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Test artifacts
coverage/
.playwright/
playwright-report/
test-results/

# Visual baselines: only the `-linux` set is committed, because CI runs
# `ubuntu-latest` and Playwright's default snapshot path carries the platform
# (SPRINT-6-PLAN §3.3). A laptop that runs `--update-snapshots` writes
# `-darwin`/`-win32` files CI can never match, so they stay out of the tree.
# Scoped to the snapshot folder so nothing else here is affected.
tests/e2e/visual.spec.ts-snapshots/*-darwin.png
tests/e2e/visual.spec.ts-snapshots/*-win32.png

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# Personal data: never commit real chat exports (PRD §E2-1, S-4)
*.zip
sample/
WhatsApp Chat with*

# Exceptions: the synthetic zips the e2e suite needs. Hand-built fixtures with
# real, generated media bytes (tests/e2e/fixtures/README.md), not chat exports.
# Scoped to the exact files so a real export dropped in this folder stays ignored.
!tests/e2e/fixtures/export.zip
!tests/e2e/fixtures/media.zip
!tests/e2e/fixtures/broken-image.zip
!tests/e2e/fixtures/sprint7-bugs.zip

# Scratch: unwanted files are moved here instead of deleted (project rule)
.trash/


.kiro
.omp
BACKLOG.md
PRD.md
.agent-report