# Response headers for the static host (backlog E1-4).
#
# Vite copies `public/` into `dist/` verbatim, and Cloudflare Pages reads
# `_headers` from the publish directory, so this file ships as `dist/_headers`
# and is never served as an asset.
#
# The policy below is the mirror `src/ui/README.md` specifies. The CSP repeats
# the `<meta http-equiv>` from `index.html` and adds the one directive a meta tag
# cannot carry, `frame-ancestors 'none'`, which is also where the clickjacking
# guard lives. Keep the two copies identical apart from that directive.
/*
  Content-Security-Policy: default-src 'self'; connect-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

# Vite writes hashed file names under /assets, so the bytes behind a URL never
# change and one year of immutable caching is safe. Cloudflare merges matching
# rules, so the security set above still applies to these paths.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
